generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum EmailStatus { SCHEDULED PROCESSING SENT FAILED }

enum JobStatus { ACTIVE COMPLETED FAILED }

model User {
  id              String           @id @default(cuid())
  googleId        String           @unique
  email           String           @unique
  name            String
  avatar          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  senders         Sender[]
  emails          Email[]
  slackConnection SlackConnection?
}

model Sender {
  id          String   @id @default(cuid())
  userId      String
  email       String
  displayName String?
  hourlyLimit Int      @default(200)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails      Email[]
  @@unique([userId, email])
  @@index([userId])
}

model Email {
  id              String      @id @default(cuid())
  userId          String
  senderId        String
  recipient       String
  subject         String
  body            String      @db.Text
  scheduledAt     DateTime
  originalAt      DateTime
  sentAt          DateTime?
  status          EmailStatus @default(SCHEDULED)
  attempts        Int         @default(0)
  bullJobId       String?     @unique
  lastError       String?
  messageId       String      @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender          Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([userId, status, scheduledAt])
  @@index([senderId, scheduledAt])
  @@index([recipient])
}

model SlackConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  teamId       String?
  teamName     String?
  accessToken  String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
